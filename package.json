{
  "name": "skyora",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/copy-mediapipe-wasm.js",
    "prepare:wasm": "node scripts/copy-mediapipe-wasm.js",
    "build:web": "npm run prepare:wasm && expo export -p web --output-dir dist",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none expo start --web --port 8081\" \"wait-on http://localhost:8081 && cross-env ELECTRON_START_URL=http://localhost:8081 node scripts/run-electron.js\"",
    "electron:preview": "npm run build:web && node scripts/run-electron.js",
    "dist:win": "npm run build:web && electron-builder --config electron-builder.yml --win",
    "deploy": "npm run build:web && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "serve:dist": "npm run build:web && firebase emulators:start --only hosting"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.2.1",
    "@react-navigation/native-stack": "^7.14.9",
    "expo": "~54.0.35",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "~54.0.10",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "firebase-tools": "^15.25.1",
    "wait-on": "^9.1.0"
  }
}
